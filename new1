local function baseIndexFor(model)
	local ok, cf = pcall(function() return (model:GetBoundingBox()) end)
	if not ok then return nil end
	local p, bestI, bestD = cf.Position
	for i, bp in ipairs(BASE_POSITIONS) do
		local dx, dz = p.X - bp.X, p.Z - bp.Z
		local d = math.sqrt(dx * dx + dz * dz)
		if not bestD or d < bestD then bestI, bestD = i, d end
	end
	return (bestD and bestD <= MATCH_TOL) and bestI or nil
end

local function isEmpty(label)
	return (label.Text:gsub("^%s+", ""):gsub("%s+$", "")) == EMPTY_TEXT
end

local function recomputeBases()
	local targetIdx
	for i = 1, #BASE_POSITIONS do
		local b = bases[i]
		if b and b.label and isEmpty(b.label) then targetIdx = i break end
	end
	if targetIdx then
		nextBaseAnchor.CFrame = bases[targetIdx].cf
		bb.Enabled = true
	else
		bb.Enabled = false
	end
end

local function connectLabel(label)
	if connectedLabels[label] then return end
	connectedLabels[label] = true
	table.insert(conns, label:GetPropertyChangedSignal("Text"):Connect(recomputeBases))
end

local function scanBases()
	for _, plot in ipairs(Plots:GetChildren()) do
		local sign  = plot:FindFirstChild("PlotSign")
		local model = sign and sign:FindFirstChild("Model")
		local gui   = sign and sign:FindFirstChild("SurfaceGui")
		local fr    = gui and gui:FindFirstChild("Frame")
		local label = fr and fr:FindFirstChild("TextLabel")
		if model and label then
			local idx = baseIndexFor(model)
			if idx then
				bases[idx] = { label = label, cf = (select(1, model:GetBoundingBox())) }
				connectLabel(label)
			end
		end
	end
	recomputeBases()
end

--==============================================================--
-- INITIALIZATION & EVENTS
--==============================================================--

buildPodiums()
buildSlotNumbers()
scanBases()

local pending = false
local function rebuildAll()
	if pending or not alive then return end
	pending = true
	task.delay(0.4, function() 
		pending = false 
		if alive then
			buildPodiums()
			buildSlotNumbers()
		end
	end)
end

local function watchPlotPodiums(plot)
	local pods = plot:WaitForChild("AnimalPodiums", 20)
	if pods and alive then
		table.insert(conns, pods.ChildAdded:Connect(rebuildAll))
		table.insert(conns, pods.ChildRemoved:Connect(rebuildAll))
	end
end

for _, plot in ipairs(Plots:GetChildren()) do task.spawn(watchPlotPodiums, plot) end

table.insert(conns, Plots.ChildAdded:Connect(function(plot)
	task.spawn(watchPlotPodiums, plot)
	rebuildAll()
	task.defer(scanBases)
end))

table.insert(conns, Plots.DescendantAdded:Connect(function(d)
	if d:IsA("TextLabel") then task.defer(scanBases) end
end))

--==============================================================--
-- MAIN LOOP (RAINBOW & DISTANCE CONTROL)
--==============================================================--

table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	local hue = (os.clock() * RAINBOW_SPEED) % 1
	rainbowColor = Color3.fromHSV(hue, 0.9, 1)

	top.TextColor3 = rainbowColor

	-- Update Warna Podium
	for _, obj in ipairs(colorObjects) do
		if obj and obj.Parent then
			obj.Color3 = rainbowColor
			if obj:IsA("SelectionBox") then
				obj.SurfaceColor3 = rainbowColor
			end
		end
	end

	-- Update Warna Nomor Slot
	if numberFolder then
		for _, anchorPart in ipairs(numberFolder:GetChildren()) do
			local billboard = anchorPart:FindFirstChild("SlotNumber")
			if billboard then
				local circle = billboard:FindFirstChild("Circle")
				if circle then
					local stroke = circle:FindFirstChild("RainbowBorder")
					if stroke then stroke.Color = rainbowColor end
				end
				local stem = billboard:FindFirstChild("Stem")
				if stem then stem.BackgroundColor3 = rainbowColor end
			end
		end
	end

	-- Update visibilitas nomor slot berdasarkan jarak 50 studs
	updateNumberDistance()

	-- Animasi Denyut Podium
	local w = math.sin(os.clock() * PULSE_SPEED) * PULSE_AMOUNT
	for _, f in ipairs(fills) do
		if f.a.Parent then f.a.Transparency = math.clamp(f.base + w, 0, 1) end
	end
end))

