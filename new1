local function getSlotNumberCF(root, slot, parts, index)
	if parts and parts[1] then
		local p = parts[1]
		return p.CFrame * CFrame.new(0, (p.Size.Y * 0.5) + 0.15, 0)
	end
	local e = TEMPLATE[index]
	local localCF = CFrame.new(e[1], e[2], e[3]) * CFrame.Angles(0, math.rad(e[4]), 0)
	return root.CFrame * localCF * CFrame.new(0, OUTER.Y * 0.5, 0)
end

local function buildSlotNumbers()
	if not alive then return end
	destroySlotNumbers()
	for _, plot in ipairs(Plots:GetChildren()) do
		local root = plot:FindFirstChild("MainRoot")
		local pods = plot:FindFirstChild("AnimalPodiums")
		if root and pods then
			for i = 1, #TEMPLATE do
				local slot = pods:FindFirstChild(tostring(i))
				local parts = slot and slabsOf(slot)
				local worldCF = getSlotNumberCF(root, slot, parts, i)
				if worldCF then createSlotNumber(i, worldCF) end
			end
		end
	end
end

local function updateNumberDistance()
	if not numberFolder or not LocalPlayer.Character then return end
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local playerPos = hrp.Position
	for _, anchorPart in ipairs(numberFolder:GetChildren()) do
		if anchorPart:IsA("BasePart") then
			local distance = (playerPos - anchorPart.Position).Magnitude
			local billboard = anchorPart:FindFirstChild("SlotNumber")
			if billboard then
				billboard.Enabled = distance <= NUMBER_VISIBLE_DISTANCE
			end
		end
	end
end

