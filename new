local function cleanup()
	alive = false

	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end

	table.clear(conns)

	clearPodiums()
	destroySlotNumbers()

	if anchor then
		pcall(function()
			anchor:Destroy()
		end)
	end

	_G.__PodiumESPCleanup = nil
	_G.__NextBaseCleanup = nil
end

_G.__PodiumESPCleanup = cleanup
_G.__NextBaseCleanup = cleanup
