			if plr.Name:lower() == wantedName:lower() then
				target = plr
				break
			end
		end
		-- Fallback only when exactly one player has this display name.
		if not target and data.displayName then
			local matches = {}
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.DisplayName:lower() == tostring(data.displayName):lower() then
					table.insert(matches, plr)
				end
			end
			if #matches == 1 then target = matches[1] end
		end
		if not target or target == player then
			addBtn.Text = "N/A"
			task.delay(1, function()
				if addBtn.Parent then addBtn.Text = "ADD" end
			end)
			return
		end

		local success = pcall(function()
			StarterGui:SetCore("PromptSendFriendRequest", target)
		end)
		-- This means the prompt call did not throw; Roblox does not confirm the request was sent.
		addBtn.Text = success and "OPENED" or "ERROR"
		task.delay(1.5, function()
			if addBtn.Parent then addBtn.Text = "ADD" end
		end)
	end)

	-- VIEW
	local viewBtn = Instance.new("TextButton")
	viewBtn.Size = UDim2.new(0, 48, 0, 30)
	viewBtn.Position = UDim2.new(1, -105, 0.5, -15)
	viewBtn.BackgroundColor3 = COLOR_YELLOW
	viewBtn.Text = "VIEW"
	viewBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	viewBtn.Font = Enum.Font.GothamBlack
	viewBtn.TextSize = 9
	viewBtn.BorderSizePixel = 0
	viewBtn.AutoButtonColor = false
	viewBtn.Parent = slotFrame
	Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 8)

	viewBtn.MouseButton1Click:Connect(function()
		local data = slotEntries[slotId]
		if data and data.position then
			enterView(data.position, data.displayName or ("Base " .. slotId))
		end
	end)

	viewBtn.MouseButton1Down:Connect(function()
		TweenService:Create(viewBtn, TweenInfo.new(0.1), {BackgroundColor3 = COLOR_GREEN}):Play()
		viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
	viewBtn.MouseButton1Up:Connect(function()
		TweenService:Create(viewBtn, TweenInfo.new(0.1), {BackgroundColor3 = COLOR_YELLOW}):Play()
		viewBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	end)
	viewBtn.MouseLeave:Connect(function()
		TweenService:Create(viewBtn, TweenInfo.new(0.1), {BackgroundColor3 = COLOR_YELLOW}):Play()
		viewBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	end)

	-- ESP
	local espBtn = Instance.new("TextButton")
	espBtn.Size = UDim2.new(0, 48, 0, 30)
	espBtn.Position = UDim2.new(1, -55, 0.5, -15)
	espBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	espBtn.Text = "ESP"
	espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	espBtn.Font = Enum.Font.GothamBlack
	espBtn.TextSize = 9
	espBtn.BorderSizePixel = 0
	espBtn.AutoButtonColor = false
	espBtn.Parent = slotFrame
	Instance.new("UICorner", espBtn).CornerRadius = UDim.new(0, 8)

	local espStroke = Instance.new("UIStroke", espBtn)
	espStroke.Color = Color3.fromRGB(90, 90, 100)
	espStroke.Thickness = 1
	espStroke.Transparency = 0.4
	espStroke.Parent = espBtn

	local espActive = false

	espBtn.MouseButton1Click:Connect(function()
		local data = slotEntries[slotId]
		if not data then return end
		if not data.displayName or data.displayName == "" then
			espBtn.Text = "N/A"
			task.delay(0.8, function()
				if espBtn and espBtn.Parent then espBtn.Text = "ESP" end
			end)
			return
		end

		espActive = not espActive
		data.espActive = espActive

		if espActive then
			espBtn.BackgroundColor3 = COLOR_GREEN
			espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			espStroke.Color = COLOR_GREEN
			espStroke.Transparency = 0
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.DisplayName == data.displayName then
					applyESPToPlayer(plr)
				end
			end
		else
			espBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
			espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			espStroke.Color = Color3.fromRGB(90, 90, 100)
			espStroke.Transparency = 0.4
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player and plr.DisplayName == data.displayName then
					local stillActive = false
					for otherId, otherData in pairs(slotEntries) do
						if otherId ~= slotId and otherData.espActive and otherData.displayName == data.displayName then
							stillActive = true
							break
						end
					end
					if not stillActive then clearESPForPlayer(plr) end
				end
			end
		end
	end)

	espBtn.MouseEnter:Connect(function()
		if not espActive then
			TweenService:Create(espBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(70, 70, 85)}):Play()
		end
	end)
	espBtn.MouseLeave:Connect(function()
		if not espActive then
			TweenService:Create(espBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
		end
	end)

	slotEntries[slotId] = {
		frame = slotFrame,
		displayLabel = displayLabel,
		slotStroke = slotStroke,
		displayName = nil,
		username = nil,
		position = nil,
		addBtn = addBtn,
		espBtn = espBtn,
		espActive = false,
	}
end

-- BASE SCANNER
local function getBaseName(base)
	local sign = base:FindFirstChild("PlotSign")
	if not sign then return nil end
	local sg = sign:FindFirstChild("SurfaceGui")
	if not sg then return nil end
	local frame = sg:FindFirstChild("Frame")
	if not frame then return nil end
	local label = frame:FindFirstChildWhichIsA("TextLabel")
	if not label then return nil end
	return label.Text
end

local function getBasePosition(base)
	local ok, pivot = pcall(function() return base:GetPivot() end)
	if ok and pivot then return pivot.Position end

	local minV, maxV = nil, nil
	for _, part in ipairs(base:GetDescendants()) do
		if part:IsA("BasePart") then
			local p = part.Position
			if not minV then minV, maxV = p, p
			else
				minV = Vector3.new(math.min(minV.X,p.X), math.min(minV.Y,p.Y), math.min(minV.Z,p.Z))
				maxV = Vector3.new(math.max(maxV.X,p.X), math.max(maxV.Y,p.Y), math.max(maxV.Z,p.Z))
			end
		end
	end
	if minV and maxV then return (minV + maxV) / 2 end
	return nil
end

local function findPlayerByUsername(username)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name == username then return plr end
	end
	return nil
end

local function updateSlots()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return end

	local baseList = {}
	for _, base in ipairs(plots:GetChildren()) do
		table.insert(baseList, base)
	end
	table.sort(baseList, function(a, b) return a.Name < b.Name end)

	for i, base in ipairs(baseList) do
		if i > 28 then break end
		local data = slotEntries[i]
		if not data then continue end

		local nameText = getBaseName(base) or "?"
		local pos = getBasePosition(base)
		if pos then data.position = pos end

		local isFilled = nameText ~= "Empty Base" and string.find(nameText, "'s Base")

		if isFilled then
			local realUsername = string.match(nameText, "^(.-)'s Base$") or nameText
			local plr = findPlayerByUsername(realUsername)
			local displayName = plr and plr.DisplayName or realUsername

			if data.displayLabel.Text ~= displayName then
				data.displayLabel.Text = displayName				data.displayLabel.TextColor3 = COLOR_YELLOW
				data.slotStroke.Color = COLOR_YELLOW_D
				data.slotStroke.Transparency = 0.2

				if data.espActive then
					for _, otherPlr in ipairs(Players:GetPlayers()) do
						if otherPlr ~= player then clearESPForPlayer(otherPlr) end
					end
					for _, otherPlr in ipairs(Players:GetPlayers()) do
						if otherPlr ~= player and otherPlr.DisplayName == displayName then
							applyESPToPlayer(otherPlr)
						end
					end
				end
			end
			data.displayName = displayName
			data.username = realUsername
		else
			if data.displayLabel.Text ~= "Empty" then
				data.displayLabel.Text = "Empty"
				data.displayLabel.TextColor3 = COLOR_TEXT_DIM
				data.slotStroke.Color = Color3.fromRGB(50, 50, 60)
				data.slotStroke.Transparency = 0.4

				if data.espActive then
					data.espActive = false
					data.espBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
					data.espBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					local stroke = data.espBtn:FindFirstChildOfClass("UIStroke")
					if stroke then
						stroke.Color = Color3.fromRGB(90, 90, 100)
						stroke.Transparency = 0.4
					end
					task.defer(function()
						for _, otherPlr in ipairs(Players:GetPlayers()) do
							if otherPlr ~= player and not isPlayerESPActive(otherPlr) then
								clearESPForPlayer(otherPlr)
							end
						end
					end)
				end
			end
			data.displayName = nil
			data.username = nil
		end
	end
end

task.spawn(function()
	while true do
		task.wait(2)
		pcall(updateSlots)
	end
end)

task.wait(1)
pcall(updateSlots)

-- SEARCH
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local query = string.lower(searchBox.Text)
	for _, data in pairs(slotEntries) do
		if query == "" then
			data.frame.Visible = true
		else
			local display = string.lower(data.displayLabel.Text or "")
			if string.find(display, query) then
				data.frame.Visible = true
			else
				data.frame.Visible = false
			end
		end
	end
end)

