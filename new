-- ESP SYSTEM (SIMPLE — tanpa base detection)
-- ==========================================
local espHighlightCache = {}
local espBillboardCache = {}
local espLineCache = {}

local function clearESPForPlayer(plr)
	if espHighlightCache[plr] then
		pcall(function() espHighlightCache[plr]:Destroy() end)
		espHighlightCache[plr] = nil
	end
	if espBillboardCache[plr] then
		pcall(function() espBillboardCache[plr]:Destroy() end)
		espBillboardCache[plr] = nil
	end
	if espLineCache[plr] then
		local lineData = espLineCache[plr]
		pcall(function() if lineData.beam then lineData.beam:Destroy() end end)
		pcall(function() if lineData.localAttachment then lineData.localAttachment:Destroy() end end)
		pcall(function() if lineData.targetAttachment then lineData.targetAttachment:Destroy() end end)
		espLineCache[plr] = nil
	end
end

local function applyESPToPlayer(plr)
	if not plr or not plr.Character then return end
	local char = plr.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	local targetRoot = char:FindFirstChild("HumanoidRootPart")
	local localChar = player.Character
	local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
	if not hum or hum.Health <= 0 or not head then return end
	if espHighlightCache[plr] and espHighlightCache[plr].Parent == char then return end

	clearESPForPlayer(plr)

	local hl = Instance.new("Highlight")
	hl.Name = "r2k13ESP"
	hl.FillColor = COLOR_YELLOW
	hl.FillTransparency = 0.55
	hl.OutlineColor = COLOR_YELLOW
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = char
	espHighlightCache[plr] = hl

	local bb = Instance.new("BillboardGui")
	bb.Name = "r2k13ESPTag"
	bb.Size = UDim2.new(0, 150, 0, 24)
	bb.StudsOffset = Vector3.new(0, 3.8, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = head

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(1, 0, 1, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = plr.DisplayName
	nameLbl.TextColor3 = COLOR_YELLOW
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextSize = 12
	nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	nameLbl.TextStrokeTransparency = 0
	nameLbl.Parent = bb

	espBillboardCache[plr] = bb

	-- Thicker yellow line from the local player to the target.
	if targetRoot and localRoot then
		local localAttachment = Instance.new("Attachment")
		localAttachment.Name = "r2k13ESPLineLocal"
		localAttachment.Parent = localRoot

		local targetAttachment = Instance.new("Attachment")
		targetAttachment.Name = "r2k13ESPLineTarget"
		targetAttachment.Parent = targetRoot

		local beam = Instance.new("Beam")
		beam.Name = "r2k13ESPLine"
		beam.Attachment0 = localAttachment
		beam.Attachment1 = targetAttachment
		beam.Color = ColorSequence.new(COLOR_YELLOW)
		beam.Width0 = 0.12
		beam.Width1 = 0.12
		beam.Transparency = NumberSequence.new(0.1)
		beam.FaceCamera = true
		beam.LightEmission = 0.6
		beam.LightInfluence = 0
		beam.Enabled = true
		beam.Parent = localRoot
		espLineCache[plr] = {
			beam = beam,
			localAttachment = localAttachment,
			targetAttachment = targetAttachment,
		}
	end
end

local function isPlayerESPActive(plr)
	for _, data in pairs(slotEntries) do
		if data.espActive and data.displayName and plr.DisplayName == data.displayName then
			return true
		end
	end
	return false
end

local function updateESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if isPlayerESPActive(plr) then
				if plr.Character then
					local hum = plr.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then applyESPToPlayer(plr)
					else clearESPForPlayer(plr) end
				end
			else
				clearESPForPlayer(plr)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.35)
		pcall(updateESP)
	end
end)
