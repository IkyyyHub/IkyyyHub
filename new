local pendingRebuild = false

local function rebuildPodiums()
	if pendingRebuild or not alive then
		return
	end

	pendingRebuild = true

	task.delay(0.4, function()
		pendingRebuild = false

		if not alive then
			return
		end

		buildPodiums()
		buildSlotNumbers()
	end)
end

--------------------------------------------------------------------------------
-- WATCH PLOTS
--------------------------------------------------------------------------------

local function watchPlot(plot)
	local pods =
		plot:WaitForChild(
			"AnimalPodiums",
			20
		)

	if pods and alive then
		conns[#conns + 1] =
			pods.ChildAdded
			:Connect(rebuildPodiums)

		conns[#conns + 1] =
			pods.ChildRemoved
			:Connect(rebuildPodiums)
	end
end

for _, plot in ipairs(Plots:GetChildren()) do
	task.spawn(
		watchPlot,
		plot
	)
end

conns[#conns + 1] =
	Plots.ChildAdded
	:Connect(function(plot)

		task.spawn(
			watchPlot,
			plot
		)

		rebuildPodiums()

		task.defer(
			scanBases
		)
	end)

conns[#conns + 1] =
	Plots.DescendantAdded
	:Connect(function(d)

		if d:IsA("TextLabel") then
			task.defer(
				scanBases
			)
		end
	end)

--------------------------------------------------------------------------------
-- MAIN RGB + PULSE LOOP
--------------------------------------------------------------------------------

do
	local acc = 0

	conns[#conns + 1] =
		RunService.Heartbeat
		:Connect(function(dt)

			--------------------------------------------------------
			-- RAINBOW COLOR
			--------------------------------------------------------

			local hue =
				(os.clock() * RAINBOW_SPEED) % 1

			local rainbowColor =
				Color3.fromHSV(
					hue,
					1,
					1
				)

			--------------------------------------------------------
			-- PODIUM ESP RGB
			--------------------------------------------------------

			for _, obj in ipairs(coloredObjects) do
				if obj.Parent then

					if obj:IsA(
						"BoxHandleAdornment"
					) then

						obj.Color3 =
							rainbowColor

					elseif obj:IsA(
						"SelectionBox"
					) then

						obj.Color3 =
							rainbowColor

						obj.SurfaceColor3 =
							rainbowColor
					end
				end
			end

			--------------------------------------------------------
			-- SLOT NUMBER RGB
			--------------------------------------------------------

			if numberFolder then
				for _, anchorPart in ipairs(
					numberFolder:GetChildren()
				) do

					if anchorPart.Parent then

						local billboard =
							anchorPart:FindFirstChild(
								"SlotNumber"
							)

						if billboard then

							local circle =
								billboard:FindFirstChild(
									"Circle"
								)

							if circle then

								local stroke =
									circle:FindFirstChild(
										"RainbowBorder"
									)

								if stroke then
									stroke.Color =
										rainbowColor
								end

								local stem =
									billboard:FindFirstChild(
										"Stem"
									)

								if stem then
									stem.BackgroundColor3 =
										rainbowColor
								end
							end
						end
					end
				end
			end

			--------------------------------------------------------
			-- NEXT BASE RGB
			--------------------------------------------------------

			if bb.Enabled then
				topText.TextColor3 =
					rainbowColor

				bottomText.TextColor3 =
					rainbowColor
			end

			--------------------------------------------------------
			-- PULSE TRANSPARENCY
			--------------------------------------------------------

			acc = acc + dt

			if acc >= 0.05 then
				acc = 0

				local w =
					math.sin(
						os.clock() * PULSE_SPEED
					)
					*
					PULSE_AMOUNT

				for _, f in ipairs(fills) do
					if f.a.Parent then
						f.a.Transparency =
							math.clamp(
								f.base + w,
								0,
								1
							)
					end
				end
			end
		end)
end

