local function keep(x)
	markers[#markers + 1] = x
	x.Parent = hui
	return x
end

local function clearPodiums()
	for _, m in ipairs(markers) do
		pcall(function()
			m:Destroy()
		end)
	end

	table.clear(markers)
	table.clear(fills)
	table.clear(coloredObjects)

	if solids then
		solids:ClearAllChildren()
	end
end

local function trackColor(obj)
	coloredObjects[#coloredObjects + 1] = obj
end

local function box(adornee, cf, size, trans, isFill)
	local a = Instance.new("BoxHandleAdornment")

	a.Adornee = adornee
	a.Size = size
	a.CFrame = cf
	a.Transparency = trans
	a.AlwaysOnTop = false
	a.ZIndex = 0

	keep(a)
	trackColor(a)

	if isFill then
		fills[#fills + 1] = {
			a = a,
			base = trans
		}
	end

	return a
end

local function outline(part)
	local b = Instance.new("SelectionBox")

	b.Adornee = part
	b.LineThickness = THICK
	b.Transparency = 0
	b.SurfaceTransparency = 1

	keep(b)
	trackColor(b)

	return b
end

local function edges(root, cf, size)
	local t = THICK * 1.6

	local hx = size.X * 0.5
	local hz = size.Z * 0.5
	local y = size.Y * 0.5

	box(
		root,
		cf * CFrame.new(0, y, hz),
		Vector3.new(size.X, t, t),
		0
	)

	box(
		root,
		cf * CFrame.new(0, y, -hz),
		Vector3.new(size.X, t, t),
		0
	)

	box(
		root,
		cf * CFrame.new(hx, y, 0),
		Vector3.new(t, t, size.Z),
		0
	)

	box(
		root,
		cf * CFrame.new(-hx, y, 0),
		Vector3.new(t, t, size.Z),
		0
	)
end

local function solid(worldCF)
	if not CFG.COLLIDE then
		return
	end

	if not solids then
		solids = Instance.new("Folder")
		solids.Name = "__PodiumCollide"
		solids.Parent = workspace
	end

	local p = Instance.new("Part")

	p.Anchored = true
	p.CanCollide = true
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = OUTER
	p.CFrame = worldCF

	p.Parent = solids
end

local function slabsOf(slot)
	local base = slot:FindFirstChild("Base") or slot
	local decos = base:FindFirstChild("Decorations")

	local parts = {}

	if decos then
		for _, c in ipairs(decos:GetChildren()) do
			if c:IsA("BasePart") and c.Transparency < 1 then
				parts[#parts + 1] = c
			end
		end
	end

	table.sort(parts, function(a, b)
		return a.Size.X * a.Size.Z > b.Size.X * b.Size.Z
	end)

	return parts
end

local function drawReal(parts)
	local anchorPart = parts[1]

	for i, p in ipairs(parts) do
		local rel = anchorPart.CFrame:Inverse() * p.CFrame

		box(
			anchorPart,
			rel,
			p.Size + Vector3.new(0.03, 0.03, 0.03),
			i == 1 and FILL_T or INNER_T,
			true
		)

		outline(p)
	end
end

local function drawGhost(root, e)
	local cf =
		CFrame.new(e[1], e[2], e[3])
		*
		CFrame.Angles(0, math.rad(e[4]), 0)

	box(
		root,
		cf,
		OUTER,
		FILL_T + MISS_T,
		true
	)

	box(
		root,
		cf * CFrame.new(0, INNER_UP, 0),
		INNER_SZ,
		INNER_T + MISS_T,
		true
	)

	edges(root, cf, OUTER)

	solid(root.CFrame * cf)
end

local function buildPodiums()
	if not alive then
		return
	end

	clearPodiums()

	for _, plot in ipairs(Plots:GetChildren()) do
		local root = plot:FindFirstChild("MainRoot")
		local pods = plot:FindFirstChild("AnimalPodiums")

		if root and pods then
			for i = 1, #TEMPLATE do
				local sl = pods:FindFirstChild(tostring(i))
				local parts = sl and slabsOf(sl)

				if parts and parts[1] then
					drawReal(parts)
				else
					drawGhost(root, TEMPLATE[i])
				end
			end
		end
	end
end

