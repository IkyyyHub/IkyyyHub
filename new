-- CAMERA FUNCTIONS
local function updateCamera()
	if not isViewing then return end
	local cosY = math.cos(camAngleY)
	local offset = Vector3.new(
		math.sin(camAngleX) * cosY,
		math.sin(camAngleY),
		math.cos(camAngleX) * cosY
	) * camDistance
	local camPos = viewCenter + offset + Vector3.new(0, camHeight, 0)
	camera.CFrame = CFrame.new(camPos, viewCenter)
end

local function enterView(pos, label)
	if isViewing then
		exitView()
		task.wait(0.15)
	end
	isViewing = true
	viewCenter = pos
	camAngleX = 0
	camAngleY = -0.35
	camDistance = 45
	camHeight = 10
	originalSubject = camera.CameraSubject
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CameraSubject = nil

	local targetOffset = Vector3.new(
		math.sin(camAngleX) * math.cos(camAngleY),
		math.sin(camAngleY),
		math.cos(camAngleX) * math.cos(camAngleY)
	) * camDistance
	local targetCF = CFrame.new(viewCenter + targetOffset + Vector3.new(0, camHeight, 0), viewCenter)

	if camTween then camTween:Cancel() end
	camTween = TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = targetCF,
	})
	camTween:Play()

	backBtn.Visible = true
	viewLabel.Text = label or "Viewing"
	viewLabel.Visible = true
end

local function exitView()
	if not isViewing then return end
	isViewing = false
	isDragging = false
	camera.CameraType = Enum.CameraType.Custom
	if originalSubject then
		camera.CameraSubject = originalSubject
	elseif player.Character then
		local hum = player.Character:FindFirstChildWhichIsA("Humanoid")
		if hum then camera.CameraSubject = hum end
	end
	backBtn.Visible = false
	viewLabel.Visible = false
end

backBtn.MouseButton1Click:Connect(exitView)

-- PINCH ZOOM SMOOTH
UserInputService.TouchPinch:Connect(function(touchPositions, scale, velocity, state)
	if not isViewing then return end
	local delta = (1 - scale) * 35
	camDistance = math.clamp(camDistance + delta, 8, 300)
	updateCamera()
end)

-- INPUT
local activeDragInput = nil
local ROTATE_SENSITIVITY = 0.004

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not isViewing then return end
	if input.KeyCode == Enum.KeyCode.Escape then exitView(); return end
	if input.UserInputType == Enum.UserInputType.Touch then
		if gameProcessed then return end
		if not activeDragInput then
			activeDragInput = input
			isDragging = true
			lastMousePos = input.Position
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		if gameProcessed then return end
		isDragging = true
		lastMousePos = input.Position
	end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if not isViewing then return end
	if input.UserInputType == Enum.UserInputType.Touch then
		if activeDragInput == input and isDragging and lastMousePos then
			local delta = input.Position - lastMousePos
			camAngleX = camAngleX - delta.X * ROTATE_SENSITIVITY
			camAngleY = math.clamp(camAngleY + delta.Y * ROTATE_SENSITIVITY, -1.3, 1.3)
			lastMousePos = input.Position
			updateCamera()
		end
	elseif input.UserInputType == Enum.UserInputType.MouseMovement then
		if isDragging and lastMousePos then
			local delta = input.Position - lastMousePos
			camAngleX = camAngleX - delta.X * ROTATE_SENSITIVITY
			camAngleY = math.clamp(camAngleY + delta.Y * ROTATE_SENSITIVITY, -1.3, 1.3)
			lastMousePos = input.Position
			updateCamera()
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		if activeDragInput == input then
			activeDragInput = nil
			isDragging = false
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDragging = false
	end
end)

-- KEYBOARD PAN
RunService.RenderStepped:Connect(function(dt)
	if not isViewing then return end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	local moveSpeed = camDistance * 1.5 * dt
	local moved = false
	local forward = (camera.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
	local right = (camera.CFrame.RightVector * Vector3.new(1, 0, 1)).Unit

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then viewCenter = viewCenter + forward * moveSpeed; moved = true end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then viewCenter = viewCenter - forward * moveSpeed; moved = true end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then viewCenter = viewCenter - right * moveSpeed; moved = true end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then viewCenter = viewCenter + right * moveSpeed; moved = true end
	if UserInputService:IsKeyDown(Enum.KeyCode.E) then viewCenter = viewCenter + Vector3.new(0, moveSpeed, 0); moved = true end
	if UserInputService:IsKeyDown(Enum.KeyCode.Q) then viewCenter = viewCenter - Vector3.new(0, moveSpeed, 0); moved = true end
	if moved then updateCamera() end
end)

