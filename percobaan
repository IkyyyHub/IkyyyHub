_G.__CombinedScriptCleanup = function()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(conns)
	
	clearPodiums()
	if solids then solids:Destroy() solids = nil end
	if nextBaseAnchor then nextBaseAnchor:Destroy() end
	
	_G.__PodiumESPCleanup = nil
	_G.__NextBaseCleanup = nil
	_G.__CombinedScriptCleanup = nil
end

_G.__PodiumESPCleanup = _G.__CombinedScriptCleanup
_G.__NextBaseCleanup = _G.__CombinedScriptCleanup
