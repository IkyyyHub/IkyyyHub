buildPodiums()
scanBases()

local pendingRebuild = false
local function rebuildPodiums()
	if pendingRebuild or not alive then return end
	pendingRebuild = true
	task.delay(0.4, function() pendingRebuild = false buildPodiums() end)
end

local function watchPlot(plot)
	local pods = plot:WaitForChild("AnimalPodiums", 20)
	if pods and alive then
		conns[#conns + 1] = pods.ChildAdded:Connect(rebuildPodiums)
		conns[#conns + 1] = pods.ChildRemoved:Connect(rebuildPodiums)
	end
end

for _, plot in ipairs(Plots:GetChildren()) do task.spawn(watchPlot, plot) end

conns[#conns + 1] = Plots.ChildAdded:Connect(function(plot)
	task.spawn(watchPlot, plot)
	rebuildPodiums()
	task.defer(scanBases)
end)

conns[#conns + 1] = Plots.DescendantAdded:Connect(function(d)
	if d:IsA("TextLabel") then task.defer(scanBases) end
end)

--------------------------------------------------------------------------------
-- MAIN LOOP (PULSE & RAINBOW SHIFTING)
--------------------------------------------------------------------------------
do
	local acc = 0
	conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
		local hue = (os.clock() * RAINBOW_SPEED) % 1
		local rainbowColor = Color3.fromHSV(hue, 1, 1)

		-- Update Rainbow RGB pada Box & ESP Outlines
		for _, obj in ipairs(coloredObjects) do
			if obj.Parent then
				if obj:IsA("BoxHandleAdornment") then
					obj.Color3 = rainbowColor
				elseif obj:IsA("SelectionBox") then
					obj.Color3 = rainbowColor
					obj.SurfaceColor3 = rainbowColor
				end
			end
		end

		-- Update Rainbow RGB pada Text Billboard Next Base
		if bb.Enabled then
			topText.TextColor3 = rainbowColor
			bottomText.TextColor3 = rainbowColor
		end

		-- Pulse Transparency
		acc = acc + dt
		if acc >= 0.05 then
			acc = 0
			local w = math.sin(os.clock() * PULSE_SPEED) * PULSE_AMOUNT
			for _, f in ipairs(fills) do
				if f.a.Parent then f.a.Transparency = math.clamp(f.base + w, 0, 1) end
			end
		end
	end)
end

